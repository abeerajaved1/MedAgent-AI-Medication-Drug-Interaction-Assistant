# ---- Choose ONE provider: "gemini" or "grok" ----
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio — free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Grok (xAI — has a free/trial tier) ---
# Get a key at https://console.x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# --- App config ---
APP_PORT=8000
DATABASE_PATH=./data/medagent.db
LOG_LEVEL=INFO

# --- External data sources (free, no key required) ---
# RxNorm (NIH/NLM) + openFDA drug label API — set to false to run
# purely on the local RAG knowledge base / seed database.
EXTERNAL_SOURCES_ENABLED=true
EXTERNAL_TIMEOUT_SECONDS=6

# --- Phase 1: vector DB + embeddings ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=pritamdeka/S-PubMedBert-MS-MARCO

# --- Phase 3: Safety Agent veto / re-draft loop ---
# How many times the Pharmacist Agent may revise a draft after a Safety
# Agent rejection before the system just returns the last draft as-is.
MAX_VETO_ROUNDS=1

# --- Phase 4: Vision Agent (chest X-ray, requires LLM_PROVIDER=gemini) ---
VISION_MODEL_NAME=gemini-2.0-flash
