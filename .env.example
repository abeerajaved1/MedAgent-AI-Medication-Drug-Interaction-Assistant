# ---- Choose ONE provider: "gemini" or "grok" ----
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio — free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Grok (xAI — has a free/trial tier) ---
# Get a key at https://console.x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# --- App config ---
APP_PORT=8000
DATABASE_PATH=./data/medagent.db
LOG_LEVEL=INFO

# --- External data sources (free, no key required) ---
# RxNorm (NIH/NLM) + openFDA drug label API — set to false to run
# purely on the local RAG knowledge base / seed database.
EXTERNAL_SOURCES_ENABLED=true
EXTERNAL_TIMEOUT_SECONDS=6
